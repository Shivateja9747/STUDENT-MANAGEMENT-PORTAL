		{
			"name": "Part C Enterprise Features",
			"item": [
				{
					"name": "Get Calendar Events",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/calendar", "host": ["{{baseUrl}}"], "path": ["api", "calendar"] }
					}
				},
