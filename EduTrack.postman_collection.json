						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@edutrack.edu\",\n  \"phone\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"profile"
							]
						}
					}
				},
				{
